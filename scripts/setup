#!/usr/bin/env bash
# Create .venv with Home Assistant to run it locally (tests use requirements_test.txt, see README).
set -euo pipefail
cd "$(dirname "$0")/.."

rm -rf .venv
python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r requirements_dev.txt
echo "Done. Start Home Assistant with: scripts/develop"
